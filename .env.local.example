# Firebase project config (Firebase Console -> Project settings -> General -> Your apps -> SDK setup and config)
NEXT_PUBLIC_FIREBASE_API_KEY= "AIzaSyA5dtAz9Nd34X23GmzYUGqjuIU7fOijcVQ"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN= "purdue-nsds-task-planner.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID= "purdue-nsds-task-planner"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET= "purdue-nsds-task-planner.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID= "89164719363"
NEXT_PUBLIC_FIREBASE_APP_ID= "1:89164719363:web:fc6f42d3969d4ae8e8b536"

# Email domain allowed to sign in (no leading @)
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN= purdue.edu

# Comma-separated list of emails that get the "admin" role the first time they sign in.
# Only matters the FIRST time each of these users logs in (creates their user doc as admin).
NEXT_PUBLIC_ADMIN_EMAILS= gupt1142@purdue.edu

# Optional. Phones and other computers on your network can open the dev server without this.
# Only set it for a tunnel, e.g. DEV_ORIGINS=*.trycloudflare.com (hostnames only, comma-separated).
DEV_ORIGINS=

# ---- Server-only settings for the Announcements email feature (never prefix these with NEXT_PUBLIC_) ----
# Public address of the deployed app, used for the logo and buttons inside emails. Optional.
NEXT_PUBLIC_APP_URL=

# Firebase service account: Firebase console -> Project settings -> Service accounts -> Generate new private key.
# Paste the whole downloaded JSON on ONE line. This is a real secret: never commit it.
FIREBASE_SERVICE_ACCOUNT=

# SMTP account the emails are sent from (a club Gmail address with an App Password works).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
